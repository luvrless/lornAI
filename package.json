{
  "name": "flairgpt",
  "version": "1.0.0",
  "private": true,
  "description": "FlairGPT — an AI coding agent powered by Flair 5.5 (abliteration.ai), with Gemini and DeepSeek as secondary models.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env server.js --api-only\" \"vite\"",
    "build": "vite build && node -e \"import('node:fs').then(fs => fs.cpSync('dist', '.next', {recursive: true, force: true}))\"",
    "pages:build": "npm run build",
    "start": "node --env-file-if-exists=.env server.js",
    "deploy": "vite build && wrangler deploy"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11",
    "wrangler": "^3.99.0"
  }
}
