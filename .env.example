# Copy to .env (Node) or .dev.vars (wrangler dev) and fill in. Never commit real keys.
# Main model — Flair 5.5 (https://abliteration.ai). ABLIT_KEY is accepted as an alias.
FLAIR_API_KEY=ak_YOUR_API_KEY
# Second model — Google Gemini
GEMINI_API_KEY=
# Optional — DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# Node server port
PORT=8787
