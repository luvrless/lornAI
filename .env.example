# --- required ---
DATABASE_URL=postgres://lorn:password@127.0.0.1:5432/lorn
APP_URL=https://lorn.lol
# 32+ random bytes, base64:  openssl rand -base64 32
SESSION_SECRET=
ENCRYPTION_KEY=
LORN_OWNER_DISCORD_ID=409564774444171265

# --- server ---
PORT=3000
NODE_ENV=production
TRUST_PROXY=true            # only behind a reverse proxy that sets X-Forwarded-For

# --- Discord OAuth (redirect: https://lorn.lol/api/auth/discord/callback, scope: identify) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Google OAuth (redirect: https://lorn.lol/api/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- email ---
SMTP_URL=                   # smtps://user:pass@smtp.example.com:465
MAIL_FROM=LORN.LOL <no-reply@lorn.lol>

# --- media storage: local disk by default; set S3_* for S3/R2/B2/MinIO ---
STORAGE_DIR=./data/media
S3_ENDPOINT=                # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=false
MEDIA_PUBLIC_URL=            # public base URL of the bucket / CDN

# --- payments (Stripe). Purchases stay off until both are set AND enabled in the admin panel ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=      # endpoint: https://lorn.lol/api/webhooks/stripe

# --- integrations (each widget shows "not configured" until its key is set) ---
GITHUB_TOKEN=               # optional, raises the GitHub rate limit
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- Server Booster badge: a bot in your Discord server (needs the Server Members intent) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Google sign-in through Supabase Auth (used when GOOGLE_CLIENT_ID isn't set) ---
SUPABASE_URL=                # https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=    # sb_publishable_...
# Keep the redirect URL your OAuth apps already allow (NextAuth style):
OAUTH_CALLBACK_PATH=/api/auth/callback/{provider}
