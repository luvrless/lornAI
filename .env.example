# lorn.lol configuration — all optional. The platform runs fully with ZERO keys;
# the live keyless sources need nothing here. Add keys to activate key-ready sources.

# Signing secret for session cookies (auto-generated to data/.secret if unset)
# LORN_SECRET=change-me-to-a-long-random-string

# --- Key-ready source credentials (optional) ---
# HIBP_API_KEY=               # Have I Been Pwned (breach exposure)
# VIRUSTOTAL_API_KEY=
# SHODAN_API_KEY=
# ABUSEIPDB_API_KEY=
# SECURITYTRAILS_API_KEY=
# IPINFO_TOKEN=
